#!/bin/sh
# meownetvpn CLI — manage the VLESS/Xray policy-routing module
CONF="meownetvpn"
NFT_TABLE="inet meownetvpn"
NFT_SET="meownetvpn_subnets"
SOCKS_PORT="$(uci -q get $CONF.settings.socks_port || echo 1180)"
PROXY="socks5h://127.0.0.1:${SOCKS_PORT}"
TUN="$(uci -q get $CONF.settings.tun_name || echo mtun0)"
STATE_DIR="/tmp/meownetvpn"; [ -d "$STATE_DIR" ] || mkdir -p "$STATE_DIR" 2>/dev/null
TRAFFIC_LOG="$STATE_DIR/traffic.csv"
VER_FILE="/etc/meownetvpn/VERSION"
VERSION=0.0.0; [ -r "$VER_FILE" ] && read -r VERSION < "$VER_FILE"
REPO_RAW="${MEOWNETVPN_REPO:-https://raw.githubusercontent.com/Nikolay4ru/meowmeiru/main}"
# fetch a repo file: try via the tunnel first (raw.githubusercontent is DPI-blocked
# in RU), then direct as a fallback.
repo_dl() { curl -fs --proxy "$PROXY" --max-time 60 -o "$2" "$REPO_RAW/$1" 2>/dev/null || curl -fs --max-time 60 -o "$2" "$REPO_RAW/$1" 2>/dev/null; }
repo_cat() { curl -fs --proxy "$PROXY" --max-time 15 "$REPO_RAW/$1" 2>/dev/null || curl -fs --max-time 15 "$REPO_RAW/$1" 2>/dev/null; }

# ── server helpers (mirror init.d) ──
server_list() { uci show "$CONF" 2>/dev/null | sed -n "s/^$CONF\.\([^.=]*\)=server$/\1/p"; }
active_server() {
	local a; a=$(uci -q get $CONF.settings.active_server)
	if [ -n "$a" ] && [ "$(uci -q get $CONF.$a)" = "server" ]; then echo "$a"; return; fi
	server_list | head -1
}
srv_get() { uci -q get "$CONF.$1.$2"; }
group_list() { uci show "$CONF" 2>/dev/null | sed -n "s/^$CONF\.\([^.=]*\)=group$/\1/p"; }
grp_get() { uci -q get "$CONF.$1.$2"; }

# ── tunnel enumeration (mirrors init.d) ──
tunnels() {
	echo "0|default|"
	local i=0 g
	for g in $(group_list); do
		[ "$(grp_get "$g" enabled)" = "0" ] && continue
		i=$((i+1)); echo "$i|group|$g"
	done
}
t_tun()   { echo "mtun$1"; }
t_socks() { echo $(( SOCKS_PORT + $1 )); }
t_mark()  { printf '0x%x' $(( 0x1042 + $1 )); }
t_set()   { [ "$2" = default ] && echo "$NFT_SET" || echo "meownetvpn_$(printf '%s' "$3" | tr -c 'a-zA-Z0-9_' '_')"; }
dnsmasq_dropin() { ls /tmp/dnsmasq.d/meownetvpn-domains.conf /tmp/dnsmasq.*.d/meownetvpn-domains.conf 2>/dev/null | head -1; }

usage() {
	cat <<EOF
meownetvpn — policy routing over VLESS/Xray (podkop-style)

Usage: meownetvpn <command>
  start | stop | restart     manage the service
  bypass on|off|status       master switch: off = everything goes direct
  health                     per-check status (drives the UI traffic light)
  events [n]                 recent module events, newest last
  report                     full support bundle (secrets masked)
  route-add <домен> [группа] route a domain through the tunnel, no restart
  route-direct <домен>       force a domain to bypass the tunnel, no restart
  route-del <домен>          drop a domain rule, no restart
  version                    show module version
  update-check               check github for a newer version
  self-update                download + install the latest version (via tunnel)
  status                     show service + tunnel health
  test                       check tunnel exit IP + a proxied domain
  ping                       latency to server + through the tunnel
  pingall                    ICMP ping (ms) to every server (pick the best)
  speedtest                  measure tunnel throughput (down/up)
  stats                      instantaneous tunnel rx/tx counters + rate
  history                    traffic samples for the dashboard chart
  update                     re-download all lists (via the tunnel) + apply
  lists                      show available community lists
  list add|del <name>        enable/disable a community list
  list show                  show enabled community lists
  server list                show configured servers (* = active)
  server add <label> <ip> <port> <user> <pass> [TCP|UDP]
  server del <name>          remove a server
  server use <name>          switch the active server
  sub <url>                  import vless servers from a subscription
                             (Clash YAML or a base64 proxy-URI list)
  install-xray               fetch and install the xray binary
  drop-mieru                 remove the leftover mieru binary (~12MB)
  group list                 show routing groups (list -> specific server tunnel)
  group add <name> <server> <list>...   route given lists via a specific server
  group del <name>           remove a routing group
  group server <name> <srv>...          set which server(s) a group uses
  set-server <host> <port> <uuid>        update the active server endpoint
  add-domain <domain>        route a single domain through the tunnel
  add-subnet <cidr>          route a subnet through the tunnel
  count                      how many subnets are loaded
EOF
}

case "$1" in
	start|stop|restart) /etc/init.d/meownetvpn "$1" ;;
	bypass)
		# master switch: "off" tears the bypass down completely AND survives a
		# reboot (settings.enabled=0), so nothing on the router is routed through
		# the tunnel until it is turned back on.
		case "$2" in
			off)
				uci set $CONF.settings.enabled=0; uci commit $CONF
				/etc/init.d/meownetvpn stop >/dev/null 2>&1
				echo "обход ВЫКЛЮЧЕН — весь трафик идёт напрямую (переживёт перезагрузку)"
				echo "включить обратно: meownetvpn bypass on" ;;
			on)
				uci set $CONF.settings.enabled=1; uci commit $CONF
				/etc/init.d/meownetvpn start >/dev/null 2>&1
				echo "обход включён" ;;
			status|"")
				en=$(uci -q get $CONF.settings.enabled)
				[ "$en" = "1" ] && echo "enabled: yes" || echo "enabled: no"
				nft list table $NFT_TABLE >/dev/null 2>&1 && echo "nft_table: present" || echo "nft_table: absent"
				echo "ip_rules: $(ip rule show 2>/dev/null | grep -c fwmark)"
				echo "tun_devs: $(ip -br link show 2>/dev/null | grep -c mtun)"
				echo "processes: $(ps w | grep -cE '[m]ieru run|[h]ev-socks5')"
				echo "marked_conns: $(grep -c 'mark=41' /proc/net/nf_conntrack 2>/dev/null)"
				echo "dnsmasq_dropin: $(ls /tmp/dnsmasq.d/meownetvpn*.conf /tmp/dnsmasq.*.d/meownetvpn*.conf 2>/dev/null | wc -l)" ;;
			*) echo "usage: meownetvpn bypass [on|off|status]"; exit 1 ;;
		esac ;;
	health)
		# One line per check, consumed by the LuCI traffic light:
		#   check|<id>|<ok|warn|bad|na>|<текст>|<команда-починки>
		# Deliberately per-tunnel: a single global pgrep reports "connected" while
		# group tunnels are dead (that was the 1.3.8 outage).
		emit() { echo "check|$1|$2|$3|${4:-}"; }
		if [ "$(cat /etc/meownet-role 2>/dev/null)" = "node" ]; then
			emit role na "Mesh-нода — обход обеспечивает главный роутер"; exit 0
		fi
		if [ "$(uci -q get $CONF.settings.enabled)" != "1" ]; then
			emit enabled warn "Обход выключен — весь трафик идёт напрямую" "bypass on"; exit 0
		fi
		emit enabled ok "Обход включён"
		# sets are legitimately empty for a few seconds after a restart
		up=99999; [ -r "$STATE_DIR/started" ] && { read st < "$STATE_DIR/started"; up=$(( $(date +%s) - st )); }
		grace=0; [ "$up" -lt 45 ] && grace=1
		if nft list table $NFT_TABLE >/dev/null 2>&1; then
			emit nft ok "Правила маршрутизации загружены"
		else
			emit nft bad "Нет таблицы nftables — маршрутизация не работает" "restart"
		fi
		if dnsmasq --version 2>&1 | tr ' ' '\n' | grep -qx nftset; then
			dc=$(dnsmasq_dropin)
			if [ -s "$dc" ]; then
				emit dns ok "Доменная маршрутизация: $(grep -c '^nftset=' "$dc") правил"
			else
				emit dns bad "Нет правил доменной маршрутизации" "update"
			fi
		else
			emit dns bad "dnsmasq без поддержки nftset — доменные списки не работают" ""
		fi
		for line in $(tunnels); do
			idx=${line%%|*}; rest=${line#*|}; kind=${rest%%|*}; g=${rest#*|}
			if [ "$kind" = default ]; then nm="Основной"; else nm=$(grp_get "$g" label); [ -n "$nm" ] || nm="$g"; fi
			tun=$(t_tun "$idx"); sp=$(t_socks "$idx"); mk=$(t_mark "$idx"); stn=$(t_set "$idx" "$kind" "$g")
			prob=""
			[ -d "/sys/class/net/$tun" ] || prob="нет интерфейса $tun"
			[ -z "$prob" ] && ! netstat -tln 2>/dev/null | grep -q "127.0.0.1:$sp " && prob="xray не слушает порт $sp"
			[ -z "$prob" ] && ! ip rule show 2>/dev/null | grep -q "fwmark $mk" && prob="нет правила маршрутизации"
			[ -n "$prob" ] && { emit "tun$idx" bad "$nm: $prob" "restart"; continue; }
			code=$(curl -fs --socks5-hostname "127.0.0.1:$sp" --max-time 6 -o /dev/null -w '%{http_code}' http://www.gstatic.com/generate_204 2>/dev/null)
			cnt=$(nft list set $NFT_TABLE "$stn" 2>/dev/null | tr ',' '\n' | grep -cE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+')
			case "$code" in
				204|200|301|302)
					if [ "${cnt:-0}" -lt 1 ] && [ "$grace" = 0 ]; then
						emit "tun$idx" warn "$nm: туннель жив, но список адресов пуст" "update"
					else
						emit "tun$idx" ok "$nm: работает, адресов в наборе $cnt"
					fi ;;
				*) emit "tun$idx" bad "$nm: туннель не пропускает трафик" "restart" ;;
			esac
		done
		# prefer the run stamp; file mtimes lie because unchanged lists are not rewritten
		now=$(date +%s); old=-1
		if [ -r /etc/meownetvpn/lists/.last-download ]; then
			read stamp < /etc/meownetvpn/lists/.last-download
			case "$stamp" in [0-9]*) old=$(( (now - stamp) / 86400 )) ;; esac
		fi
		if [ "$old" -lt 0 ]; then
			old=0
			for f in /etc/meownetvpn/lists/*.lst; do
				[ -f "$f" ] || continue
				m=$(date -r "$f" +%s 2>/dev/null) || m=$now
				a=$(( (now - m) / 86400 )); [ "$a" -gt "$old" ] && old=$a
			done
		fi
		if [ "$old" -gt 14 ]; then emit lists warn "Списки не обновлялись $old дн." "update"
		else emit lists ok "Списки обновлялись $old дн. назад"; fi
		# Strikes are PER-TUNNEL since the watchdog stopped restarting the whole
		# service for one flaky group: /tmp/meownetvpn.wd/<key>. The single global
		# /tmp/meownetvpn.wdfail is deleted by watchdog.sh on every run, so reading
		# it here could only ever report "no strikes".
		wdf=""
		for f in /tmp/meownetvpn.wd/*; do
			[ -s "$f" ] || continue
			read -r n < "$f"
			k=${f##*/}
			# The watchdog keeps its own bookkeeping in the same directory (the
			# reload stamp holds an epoch): a strike key is `default` or a GROUP
			# section and its value is a counter. Without this the stamp was
			# reported as a group in permanent failure for an hour after every
			# reload — a yellow traffic light nothing could clear.
			case "$n" in ''|*[!0-9]*) continue ;; esac
			if [ "$k" = default ]; then k="Основной"
			elif [ "$(uci -q get "$CONF.$k")" = "group" ]; then l=$(grp_get "$k" label); [ -n "$l" ] && k="$l"
			else continue; fi
			wdf="$wdf $k:$n"
		done
		if [ -n "$wdf" ]; then emit wd warn "Сторож фиксирует сбои подряд:$wdf"; fi
		;;
	events)
		# logread is the only journal we have; map it to ts|sev|tag|text for the UI
		# match the syslog TAG only — crond lines merely *mention* the word in the
		# command they run, and would drown the journal in "sample" every minute
		logread 2>/dev/null \
		  | grep -E 'meownetvpn(-wd|-lists)?(\[[0-9]+\])?: |dnsmasq\[[0-9]+\]: nftset' \
		  | tail -n "${2:-80}" | awk '{
			ts=$2" "$3" "$4; line=$0
			sev="info"
			if (line ~ /failed|error|Error|не запуст|abort|invalid/) sev="bad"
			else if (line ~ /strike|probe failed|megablock|stale|missing|reapply|failover/) sev="warn"
			tag="модуль"
			if (line ~ /meownetvpn-wd/) tag="сторож"
			else if (line ~ /meownetvpn-lists/) tag="списки"
			else if (line ~ /dnsmasq/) tag="dns"
			sub(/.*meownetvpn[a-z-]*(\[[0-9]*\])?: /, "", line)
			sub(/.*dnsmasq\[[0-9]*\]: /, "", line)
			print ts"|"sev"|"tag"|"line }'
		;;
	report)
		# everything a support request needs, with credentials stripped
		echo "=== meownetvpn $VERSION ==="
		echo "время:    $(date)"
		echo "модель:   $(cat /tmp/sysinfo/model 2>/dev/null)"
		echo "прошивка: $(grep -o 'OpenWrt [0-9.]*' /etc/openwrt_release 2>/dev/null | head -1)"
		echo "аптайм:   $(uptime)"
		free 2>/dev/null | head -2
		echo; echo "=== состояние ==="; /usr/bin/meownetvpn health
		echo; echo "=== туннели ==="; /usr/bin/meownetvpn tunnels
		echo; echo "=== конфигурация (секреты скрыты) ==="
		# sub_url belongs in the mask: the subscription URL carries the account
		# token, so pasting this bundle into a support chat handed over every
		# server, login and password that the other two names go to the trouble
		# of hiding — under a header promising the secrets are gone.
		uci show $CONF 2>/dev/null | sed -E "s/\.(password|username|sub_url)=.*/.\1='***'/"
		echo; echo "=== события ==="; /usr/bin/meownetvpn events 60
		;;
	route-add|route-direct|route-del)
		act="$1"; raw="$2"; grp="$3"
		[ -n "$raw" ] || { echo "usage: meownetvpn $act <домен|ссылка> [группа]"; exit 1; }
		# accept a pasted URL: strip scheme, credentials, port, path
		d=$(echo "$raw" | sed -e 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##' -e 's#^[^/@]*@##' -e 's#[/?#].*$##' -e 's#:[0-9]*$##' | tr 'A-Z' 'a-z')
		case "$d" in
			*[!a-z0-9.-]*|""|.*|*.) echo "нераспознанный домен: $raw"; exit 1 ;;
			*.*) : ;;
			*) echo "нужен домен вида example.com, получено: $d"; exit 1 ;;
		esac
		setname="$NFT_SET"
		case "$act" in
			route-add)
				if [ -n "$grp" ]; then
					[ "$(uci -q get $CONF.$grp)" = "group" ] || { echo "нет такой группы: $grp"; exit 1; }
					key="$CONF.$grp.domain"; setname="meownetvpn_$grp"
				else
					key="$CONF.user.domain"
				fi
				# -i because LuCI stores the domain exactly as typed ('Claude.ai')
				# while $d is lowercased, and -F because an unanchored '.' in a
				# BRE matched any character (an existing 'tame' hid 't.me')
				uci -q get "$key" | tr ' ' '\n' | grep -qixF "$d" && { echo "$d уже маршрутизируется"; exit 0; }
				# dnsmasq honours the FIRST nftset directive per domain (the 1.3.3 trap)
				prev=$(grep -m1 "^nftset=/$d/" "$(dnsmasq_dropin)" 2>/dev/null | sed 's/.*#//')
				[ -n "$prev" ] && [ "$prev" != "$setname" ] && \
					echo "внимание: $d уже ведёт в набор $prev — сработает та директива, а не новая"
				uci add_list "$key=$d"; uci commit $CONF ;;
			route-direct)
				key="$CONF.user.exclude_domain"; setname=meownetvpn_direct
				uci -q get "$key" | tr ' ' '\n' | grep -qixF "$d" && { echo "$d уже идёт напрямую"; exit 0; }
				uci add_list "$key=$d"; uci commit $CONF ;;
			route-del)
				found=0
				for k in user.domain user.exclude_domain $(group_list | sed 's/$/.domain/'); do
					# delete the SPELLING that is stored, not the lowercased input:
					# `uci del_list ...=claude.ai` silently removes nothing when the
					# list holds 'Claude.ai', and route-del then reported "не найден"
					# for a rule the user could plainly see
					for stored in $(uci -q get "$CONF.$k" 2>/dev/null | tr ' ' '\n' | grep -ixF "$d"); do
						uci del_list "$CONF.$k=$stored" 2>/dev/null; found=1
					done
				done
				[ "$found" = 1 ] || { echo "$d не найден в правилах"; exit 1; }
				uci commit $CONF ;;
		esac
		# rebuild sets + drop-in WITHOUT touching the tunnels; dnsmasq restarts only
		# if the drop-in actually changed
		/etc/meownetvpn/update-lists.sh apply >/dev/null 2>&1
		if [ "$act" != route-del ]; then
			# Seed the current addresses so the rule bites before the client
			# re-resolves. The first lookup races the dnsmasq reload we just caused
			# (and for a freshly routed domain it now goes through the tunnel), so
			# retry before giving up.
			seeded=0
			for try in 1 2 3; do
				for ip in $(nslookup "$d" 127.0.0.1 2>/dev/null | sed -n '/^Name:/,$p' \
				            | awk '/^Address/{print $NF}' \
				            | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'); do
					nft add element $NFT_TABLE "$setname" "{ $ip }" 2>/dev/null && seeded=$((seeded+1))
					[ "$act" = route-direct ] && command -v conntrack >/dev/null 2>&1 && \
						conntrack -D -d "$ip" >/dev/null 2>&1
				done
				[ "$seeded" -gt 0 ] && break
				sleep 1
			done
			[ "$seeded" -gt 0 ] || echo "адреса пока не определены — правило заработает после первого DNS-запроса клиента"
		fi
		case "$act" in
			route-add)    echo "$d -> через туннель${grp:+ (группа $grp)}" ;;
			route-direct) echo "$d -> напрямую, мимо туннеля" ;;
			route-del)    echo "$d -> правило удалено" ;;
		esac
		echo "применено без перезапуска туннелей"
		;;
	status)
		sv=$(active_server)
		echo "version: $VERSION"
		echo "service: $(/etc/init.d/meownetvpn running >/dev/null 2>&1 && echo running || echo stopped)"
		echo "xray:    $(pgrep -f '/usr/bin/xray' >/dev/null && echo up || echo down)"
		echo "tun2socks: $(pgrep -f hev-socks5-tunnel >/dev/null && echo up || echo down)"
		echo "tun dev: $(ip -br addr show "$TUN" 2>/dev/null || echo absent)"
		echo "server:  $(srv_get "$sv" label) ($(srv_get "$sv" address):$(srv_get "$sv" port))"
		echo "servers: $(server_list | wc -w)"
		echo "subnets: $(nft list set $NFT_TABLE $NFT_SET 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | wc -l)"
		;;
	ui-status)
		# combined dashboard poll for LuCI: status + traffic rates in ONE fork —
		# avoids the init.d-running shell (rc.common+procd source) and a full
		# nft set dump every 5s tick
		rx=0; tx=0
		[ -r /sys/class/net/$TUN/statistics/rx_bytes ] && read rx < /sys/class/net/$TUN/statistics/rx_bytes
		[ -r /sys/class/net/$TUN/statistics/tx_bytes ] && read tx < /sys/class/net/$TUN/statistics/tx_bytes
		now=$(date +%s); pf="$STATE_DIR/stats.prev"; pt=0; prx=0; ptx=0
		[ -f "$pf" ] && read pt prx ptx < "$pf"
		echo "$now $rx $tx" > "$pf"
		dt=$((now-pt)); [ "$dt" -lt 1 ] && dt=1
		rrate=0; trate=0
		if [ "$pt" -gt 0 ] && [ "$rx" -ge "$prx" ]; then rrate=$(((rx-prx)/dt)); trate=$(((tx-ptx)/dt)); fi
		sv=$(active_server)
		svc=stopped
		ubus -S call service list '{"name":"meownetvpn"}' 2>/dev/null | grep -q '"running":true' && svc=running
		cnt=—; [ -r "$STATE_DIR/subnets.count" ] && read -r cnt < "$STATE_DIR/subnets.count"
		echo "version: $VERSION"
		echo "service: $svc"
		echo "xray:    $(pgrep -f '/usr/bin/xray' >/dev/null && echo up || echo down)"
		echo "tun2socks: $(pgrep -f hev-socks5-tunnel >/dev/null && echo up || echo down)"
		echo "server:  $(srv_get "$sv" label) ($(srv_get "$sv" address):$(srv_get "$sv" port))"
		echo "subnets: $cnt"
		echo "rx_rate: $rrate"
		echo "tx_rate: $trate"
		;;
	test)
		echo -n "tunnel exit IP: "
		curl -fs --max-time 12 --proxy "$PROXY" https://api.ipify.org 2>/dev/null || echo "FAIL"
		echo
		echo -n "telegram via tunnel: "
		curl -fs --max-time 12 --proxy "$PROXY" -o /dev/null -w "HTTP %{http_code}\n" https://core.telegram.org/ 2>/dev/null || echo "FAIL"
		;;
	ping)
		sv=$(active_server); host=$(srv_get "$sv" address)
		echo -n "server_rtt_ms: "
		ping -c 3 -W 2 "$host" 2>/dev/null | awk -F'= ' '/min\/avg\/max/{split($2,a,"/"); printf "%.1f\n", a[2]; f=1} END{if(!f)print "n/a"}'
		echo -n "tunnel_rtt_ms: "
		t=$(curl -fs --proxy "$PROXY" --max-time 10 -o /dev/null -w '%{time_starttransfer}' https://www.google.com/generate_204 2>/dev/null)
		[ -n "$t" ] && [ "$t" != "0.000000" ] && awk "BEGIN{printf \"%.0f\n\", $t*1000}" || echo "n/a"
		;;
	pingall)
		# ICMP RTT to EVERY server so the user can pick the best one. Also caches the
		# result so the LuCI server dropdowns can show "· Nms" without re-pinging.
		# Output (one per line):  <section>|<label>|<ip>|<avg_ms or -->|<active?0/1>
		# Single-flight: cron, auto-best and the LuCI button all reach this arm,
		# and the cron entries coincide at :00/:30. `tee` opens the cache O_TRUNC
		# and streams line by line over ~15 s of pings, so two runs left a short
		# or interleaved file for best-server to read a server choice out of.
		if command -v flock >/dev/null 2>&1; then
			exec 9>"$STATE_DIR/.pingall.lock"
			flock -n 9 || { cat "$STATE_DIR/ping.cache" 2>/dev/null; exit 0; }
		fi
		act=$(active_server)
		{ for s in $(server_list); do
			ip=$(srv_get "$s" address); lbl=$(srv_get "$s" label)
			rtt=$(ping -c 3 -W 2 "$ip" 2>/dev/null | awk -F'= ' '/min\/avg\/max/{split($2,a,"/"); printf "%.0f", a[2]}')
			a=0; [ "$s" = "$act" ] && a=1
			echo "$s|${lbl:-$s}|$ip|${rtt:-—}|$a"
		done; } > "$STATE_DIR/ping.cache.new.$$"
		# publish in one rename: readers never see a half-written cache. The temp
		# carries the pid because the lock above is conditional — on a build
		# without flock a shared temp would just move the interleaving from
		# ping.cache into the file that then gets published as if it were whole.
		if [ -s "$STATE_DIR/ping.cache.new.$$" ]; then
			mv "$STATE_DIR/ping.cache.new.$$" "$STATE_DIR/ping.cache"
		else
			rm -f "$STATE_DIR/ping.cache.new.$$" "$STATE_DIR/ping.cache"
		fi
		cat "$STATE_DIR/ping.cache" 2>/dev/null
		# latency trend + ring-buffer trims live here (not in the every-minute
		# sample): the values only change when this cache does
		pm=$(awk -F'|' '$5==1 && $4 ~ /^[0-9]+$/{print $4; exit}' "$STATE_DIR/ping.cache" 2>/dev/null)
		[ -n "$pm" ] && echo "$(date +%s),$pm" >> "$STATE_DIR/ping.csv"
		for f in "$TRAFFIC_LOG" "$STATE_DIR/ping.csv"; do
			# per-PID temp: a shared "$f.tmp" let two trims mv over each other and
			# throw away the samples `sample` appends every minute
			[ -f "$f" ] && [ "$(wc -l < "$f")" -gt 400 ] && { tail -n 180 "$f" > "$f.tmp.$$" && mv "$f.tmp.$$" "$f"; }
			rm -f "$f.tmp.$$"
		done
		:
		;;
	pingcache)
		cat "$STATE_DIR/ping.cache" 2>/dev/null || true ;;
	clients)
		# LAN devices + their connections, and how many are routed through a tunnel
		# (conntrack mark != 0). Output: ip|host|conns|routed|bytes
		# single awk pass joining dhcp.leases — no per-client forks (LuCI polls this)
		LAN=$(ip -4 -o addr show br-lan 2>/dev/null | awk "{print \$4}" | head -1)
		selfip=${LAN%/*}; pfx=${selfip%.*}.
		leases=/tmp/dhcp.leases; [ -f "$leases" ] || leases=/dev/null
		awk -v pfx="$pfx" -v selfip="$selfip" -v lf="$leases" '
		  FILENAME==lf { if ($3!="" && $4!="" && $4!="*") h[$3]=$4; next }
		  { src=""; mk=0; b=0;
		    for(i=1;i<=NF;i++){ if($i~/^src=/&&src==""){src=substr($i,5)} if($i~/^mark=/){mk=substr($i,6)} if($i~/^bytes=/){b+=substr($i,7)} }
		    if(index(src,pfx)==1 && src!=selfip){ c[src]++; by[src]+=b; if(mk!=0&&mk!="")r[src]++ } }
		  END{ for(s in c){ host=(s in h)?h[s]:"?"; print s"|"host"|"c[s]"|"(r[s]+0)"|"by[s] } }' \
		  "$leases" /proc/net/nf_conntrack 2>/dev/null | sort -t'|' -k4 -rn
		;;
	best-server)
		# Switching costs a full service restart: every TCP session on every
		# tunnel dies, fw4 is reloaded per tunnel and dnsmasq is restarted. So a
		# switch has to be worth it, and it must not fight the watchdog, which
		# writes the SAME uci key from the other direction. Unguarded, the two
		# looped: the watchdog rotates away from a server whose xray port is
		# blocked, and 15 min later the lowest ICMP time drags the tunnel right
		# back onto it — the bypass dead most of every quarter hour.
		WD_DIR=/tmp/meownetvpn.wd                # per-tunnel strike files (watchdog.sh)
		SEEN="$STATE_DIR/best.active"          # active_server as WE last left it
		BLACK="$STATE_DIR/best.blacklist"      # <section> <until-epoch>
		HYST_MS=25                             # ICMP jitter here is ~3 ms
		BLACK_TTL=3600
		now=$(date +%s)
		[ -s "$STATE_DIR/ping.cache" ] || /usr/bin/meownetvpn pingall >/dev/null 2>&1
		cur=$(active_server)
		# The watchdog is the authority on "does this tunnel pass traffic": while
		# it holds a strike on the default tunnel it is bouncing xray and may
		# failover on its next run. Two writers, two restarts — stay out.
		[ -s "$WD_DIR/default" ] && { echo "сторож чинит основной туннель — не переключаемся"; exit 0; }
		# active_server moved and it was not us: the watchdog failed over off
		# $prev because it stopped passing traffic (or the user picked another
		# one). Either way that verdict beats a ping time — hold off $prev for an
		# hour instead of undoing the decision on the next tick.
		prev=""; [ -r "$SEEN" ] && read -r prev < "$SEEN"
		if [ -n "$prev" ] && [ "$prev" != "$cur" ]; then
			echo "$prev $((now + BLACK_TTL))" >> "$BLACK"
			logger -t meownetvpn "best-server: $prev was left for $cur by someone else, ignoring it for ${BLACK_TTL}s"
		fi
		echo "$cur" > "$SEEN"
		if [ -s "$BLACK" ]; then
			awk -v n="$now" '$2+0 > n' "$BLACK" > "$BLACK.$$" 2>/dev/null
			mv "$BLACK.$$" "$BLACK" 2>/dev/null || rm -f "$BLACK.$$"
		fi
		# Servers the operator took out of the automatic pool are skipped too:
		# watchdog.sh's failover_pool() drops every `option failover '0'` section
		# and promises that best-server filters on the same flag. Without it the
		# operator marks a domestic exit as "never rotate here", the watchdog
		# obeys, and auto-best hands it the whole bypass 15 minutes later.
		skip=$(awk '{printf " %s", $1}' "$BLACK" 2>/dev/null)
		for s in $(server_list); do
			[ "$(srv_get "$s" failover)" = "0" ] && skip="$skip $s"
		done
		best=$(awk -F'|' -v bl="$skip " \
			'$4 ~ /^[0-9]+$/ && index(bl, " " $1 " ") == 0 {print $4"|"$1}' \
			"$STATE_DIR/ping.cache" 2>/dev/null | sort -n | head -1)
		bs=$(echo "$best" | cut -d'|' -f2); bms=$(echo "$best" | cut -d'|' -f1)
		[ -n "$bs" ] || { echo "no live server"; exit 1; }
		if [ "$bs" = "$cur" ]; then echo "already best: $(srv_get "$bs" label) (${bms}ms)"; exit 0; fi
		# hysteresis: three live servers sit within 3 ms of each other, and every
		# reshuffle of that noise used to cost a restart
		curms=$(awk -F'|' -v c="$cur" '$1==c && $4 ~ /^[0-9]+$/{print $4; exit}' "$STATE_DIR/ping.cache" 2>/dev/null)
		if [ -n "$curms" ] && [ $(( curms - bms )) -lt "$HYST_MS" ]; then
			echo "оставляем $(srv_get "$cur" label) (${curms}ms): выигрыш $(( curms - bms ))ms меньше порога ${HYST_MS}ms"
			exit 0
		fi
		# ICMP says the host is up, not that xray is reachable — a host that
		# pings while its port is blackholed is exactly the DPI failure mode this
		# module exists for. Require a completed TCP handshake to the xray port
		# first: the port never speaks HTTP, so curl always ends in a timeout and
		# only %{time_connect} tells "blocked" (0.000000) from "alive".
		ba=$(srv_get "$bs" address); bp=$(srv_get "$bs" port); bt=$(srv_get "$bs" transport)
		if [ "$bt" != UDP ] && [ -n "$ba" ] && [ -n "$bp" ]; then
			tc=$(curl -s -o /dev/null -w '%{time_connect}' --connect-timeout 4 --max-time 5 "http://$ba:$bp/" 2>/dev/null)
			if [ -z "$(printf '%s' "$tc" | tr -d '0.')" ]; then
				echo "пропускаем $(srv_get "$bs" label) (${bms}ms): порт $ba:$bp не отвечает на TCP"
				exit 1
			fi
		fi
		uci set $CONF.settings.active_server="$bs"; uci commit $CONF
		echo "$bs" > "$SEEN"
		echo "switched: $(srv_get "$bs" label) (${bms}ms)"
		/etc/init.d/meownetvpn restart >/dev/null 2>&1
		;;
	auto-best)
		[ "$(uci -q get $CONF.settings.auto_best)" = "1" ] || exit 0
		/usr/bin/meownetvpn pingall >/dev/null 2>&1
		/usr/bin/meownetvpn best-server >/dev/null 2>&1
		;;
	sub-refresh)
		[ "$(uci -q get $CONF.settings.sub_auto)" = "1" ] || exit 0
		u=$(uci -q get $CONF.settings.sub_url); [ -n "$u" ] || exit 0
		logger -t meownetvpn "auto sub-refresh"
		/usr/bin/meownetvpn sub "$u" >/dev/null 2>&1 && { /etc/init.d/meownetvpn restart >/dev/null 2>&1; /etc/meownetvpn/update-lists.sh apply >/dev/null 2>&1; }
		;;
	tunnels)
		# per-tunnel live status: name|servers|socks|exit
		# exit IP cached 300s — Overview render was firing N sequential external
		# HTTPS probes (8s timeout each) on every page open; "fresh" bypasses
		base=$(uci -q get $CONF.settings.socks_port || echo 1180)
		exit_ip() {
			c="$STATE_DIR/exit.$1"
			if [ "$2" != "fresh" ] && [ -f "$c" ]; then
				mt=$(date -r "$c" +%s 2>/dev/null || echo 0)
				if [ $(( $(date +%s) - mt )) -lt 300 ]; then cat "$c"; return; fi
			fi
			x=$(curl -fs --socks5-hostname 127.0.0.1:$1 --max-time 8 https://api.ipify.org 2>/dev/null)
			[ -n "$x" ] && echo "$x" > "$c"
			echo "$x"
		}
		ex=$(exit_ip "$base" "$2")
		echo "default|$(srv_get "$(active_server)" label)|$base|${ex:-—}"
		i=0; for g in $(group_list); do [ "$(grp_get "$g" enabled)" = "0" ] && continue; i=$((i+1)); sp=$((base+i))
			srvs=""; for s in $(grp_get "$g" server); do srvs="$srvs $(srv_get "$s" label)"; done
			ex=$(exit_ip "$sp" "$2")
			echo "$(grp_get "$g" label) [$(grp_get "$g" community_lists)]|${srvs# }|$sp|${ex:-—}"
		done
		;;
	selfcheck)
		# per-tunnel: name|exit|country|youtube|telegram|discord
		base=$(uci -q get $CONF.settings.socks_port || echo 1180)
		chk() { n="$1"; sp="$2"
			ex=$(curl -fs --socks5-hostname 127.0.0.1:$sp --max-time 10 https://api.ipify.org 2>/dev/null)
			[ -z "$ex" ] && { echo "$n|—|—|—|—|—"; return; }
			cc=$(curl -fs --max-time 6 https://ipinfo.io/$ex/country 2>/dev/null | tr -d "\n\r ")
			yt=$(curl -fs --socks5-hostname 127.0.0.1:$sp --max-time 12 -o /dev/null -w "%{http_code}" https://www.youtube.com/ 2>/dev/null)
			tg=$(curl -fs --socks5-hostname 127.0.0.1:$sp --max-time 12 -o /dev/null -w "%{http_code}" https://core.telegram.org/ 2>/dev/null)
			dc=$(curl -fs --socks5-hostname 127.0.0.1:$sp --max-time 12 -o /dev/null -w "%{http_code}" https://discord.com/ 2>/dev/null)
			echo "$n|$ex|${cc:-?}|${yt:-000}|${tg:-000}|${dc:-000}"
		}
		chk "default" "$base"
		i=0; for g in $(group_list); do [ "$(grp_get "$g" enabled)" = "0" ] && continue; i=$((i+1)); chk "$(grp_get "$g" label)" "$((base+i))"; done
		;;
	ping-history) [ -f "$STATE_DIR/ping.csv" ] && cat "$STATE_DIR/ping.csv" || true ;;
	version) echo "$VERSION" ;;
	update-check)
		remote=$(repo_cat VERSION | tr -d ' \r\n\t')
		echo "current: $VERSION"
		echo "latest: ${remote:-unknown}"
		if [ -z "$remote" ]; then echo "status: cannot reach github (tunnel down?)"
		elif [ "$remote" = "$VERSION" ]; then echo "status: up-to-date"
		else echo "status: update-available"; fi
		;;
	self-update)
		echo "fetching latest meownetvpn from github (via tunnel)…"
		d=/tmp/mnup; rm -rf "$d"; mkdir -p "$d"; ok=1
		# (file repo-path : local)
		for pair in \
			"files/etc/init.d/meownetvpn:initd" \
			"files/etc/meownetvpn/update-lists.sh:ul" \
			"files/etc/meownetvpn/watchdog.sh:wd" \
			"files/etc/meownetvpn/lists/exclude.lst:excl" \
			"files/usr/bin/meownetvpn:cli" \
			"luci/htdocs/luci-static/resources/meownetvpn/lib.js:lib" \
			"luci/htdocs/luci-static/resources/view/meownetvpn/overview.js:v_overview" \
			"luci/htdocs/luci-static/resources/view/meownetvpn/servers.js:v_servers" \
			"luci/htdocs/luci-static/resources/view/meownetvpn/routing.js:v_routing" \
			"luci/htdocs/luci-static/resources/view/meownetvpn/diagnostics.js:v_diagnostics" \
			"luci/htdocs/luci-static/resources/view/meownetvpn/settings.js:v_settings" \
			"luci/root/usr/share/luci/menu.d/luci-app-meownetvpn.json:menu" \
			"luci/root/usr/share/rpcd/acl.d/luci-app-meownetvpn.json:acl" \
			"VERSION:ver"; do
			repo_dl "${pair%%:*}" "$d/${pair##*:}" && [ -s "$d/${pair##*:}" ] || { echo "  download failed: ${pair%%:*}"; ok=0; }
		done
		# Sanity: shell scripts must parse and the LuCI files must look like ours.
		# Every check says WHAT failed — a silent ok=0 made a broken update
		# indistinguishable from a network problem for three releases.
		for f in initd ul wd cli; do
			sh -n "$d/$f" 2>/dev/null || { echo "  не разбирается как скрипт: $f"; ok=0; }
		done
		grep -q "loadTunnels" "$d/lib" 2>/dev/null || { echo "  lib.js не похож на наш (нет loadTunnels)"; ok=0; }
		# Views call lib.page(); `view.extend` lives in lib.js since 1.3.0 — requiring
		# it here is what silently blocked every self-update after that refactor.
		for v in v_overview v_servers v_routing v_diagnostics v_settings; do
			grep -qE "lib\.page\(|view\.extend" "$d/$v" 2>/dev/null || { echo "  не похож на страницу LuCI: $v"; ok=0; }
		done
		case "$(cat "$d/ver" 2>/dev/null | tr -d ' \r\n\t')" in
			[0-9]*.[0-9]*.[0-9]*) : ;;
			*) echo "  в VERSION не номер версии"; ok=0 ;;
		esac
		[ "$ok" = 1 ] || { echo "обновление отменено (см. причину выше) — осталась версия $VERSION"; rm -rf "$d"; exit 1; }
		cp "$d/initd" /etc/init.d/meownetvpn; cp "$d/ul" /etc/meownetvpn/update-lists.sh
		cp "$d/wd" /etc/meownetvpn/watchdog.sh; cp "$d/cli" /usr/bin/meownetvpn
		mkdir -p /etc/meownetvpn/lists; cp "$d/excl" /etc/meownetvpn/lists/exclude.lst
		mkdir -p /www/luci-static/resources/meownetvpn /www/luci-static/resources/view/meownetvpn
		cp "$d/lib" /www/luci-static/resources/meownetvpn/lib.js
		for v in overview servers routing diagnostics settings; do cp "$d/v_$v" "/www/luci-static/resources/view/meownetvpn/$v.js"; done
		rm -f /www/luci-static/resources/view/meownetvpn/main.js
		cp "$d/menu" /usr/share/luci/menu.d/luci-app-meownetvpn.json
		cp "$d/acl" /usr/share/rpcd/acl.d/luci-app-meownetvpn.json
		mkdir -p /etc/meownetvpn; cp "$d/ver" "$VER_FILE"
		chmod +x /etc/init.d/meownetvpn /usr/bin/meownetvpn /etc/meownetvpn/*.sh
		sed -i "s/^Version: .*/Version: $(cat "$VER_FILE")/" /usr/lib/opkg/info/meownetvpn.control 2>/dev/null
		rm -f /tmp/luci-indexcache* /tmp/luci-modulecache/* 2>/dev/null; /etc/init.d/rpcd reload >/dev/null 2>&1
		/etc/init.d/meownetvpn restart >/dev/null 2>&1
		rm -rf "$d"
		echo "updated to $(cat "$VER_FILE")"
		;;
	update-auto)
		# cron: self-update only if enabled AND a newer version exists
		[ "$(uci -q get $CONF.settings.auto_update)" = "1" ] || exit 0
		remote=$(repo_cat VERSION | tr -d ' \r\n\t')
		[ -n "$remote" ] && [ "$remote" != "$VERSION" ] || exit 0
		logger -t meownetvpn "auto-update $VERSION -> $remote"
		/usr/bin/meownetvpn self-update >/dev/null 2>&1
		;;
	speedtest)
		# Cloudflare's speed endpoint refuses xray/datacenter IPs (returns 0) — use
		# Google's CDN which is reliably reachable through the tunnel. Try a couple of
		# mirrors so a single dead URL doesn't read as "0".
		spd=""; sz=0
		for u in \
			"https://dl.google.com/dl/android/studio/install/2021.1.1.21/android-studio-2021.1.1.21-cros.deb" \
			"https://dl.google.com/go/go1.21.0.linux-amd64.tar.gz" \
			"https://speed.cloudflare.com/__down?bytes=20000000"; do
			res=$(curl -fs --proxy "$PROXY" --max-time 15 -o /dev/null -w '%{speed_download} %{size_download}' --range 0-20000000 "$u" 2>/dev/null)
			spd=$(echo "$res" | awk '{print $1}'); sz=$(echo "$res" | awk '{print $2}')
			[ -n "$spd" ] && [ "${sz:-0}" -gt 1000000 ] && break
		done
		if [ -n "$spd" ] && [ "${sz:-0}" -gt 1000000 ]; then
			awk "BEGIN{printf \"down_mbps: %.1f\n\", $spd*8/1000000}"
		else
			echo "down_mbps: 0"; echo "note: download failed (tunnel down?)"
		fi
		# upload measured against Google's generate_204 collector is unreliable; keep
		# Cloudflare __up but treat 0 as "n/a" rather than a real reading
		# per-PID name + trap: the fixed /tmp/meownetvpn/up.bin was shared by two
		# clicks from two browser tabs (one run's rm pulled the file out from
		# under the other's upload) and was left behind in tmpfs whenever rpcd
		# killed the exec mid-test
		tmp="$STATE_DIR/up.$$.bin"; trap 'rm -f "$tmp"' EXIT INT TERM
		head -c 8000000 /dev/zero > "$tmp" 2>/dev/null
		up=$(curl -fs --proxy "$PROXY" --max-time 10 -o /dev/null \
			-w '%{speed_upload}' --data-binary @"$tmp" \
			"https://speed.cloudflare.com/__up" 2>/dev/null)
		rm -f "$tmp"
		if [ -n "$up" ] && awk "BEGIN{exit !($up>10000)}"; then
			awk "BEGIN{printf \"up_mbps: %.1f\n\", $up*8/1000000}"
		else echo "up_mbps: n/a"; fi
		;;
	stats)
		rx=$(cat /sys/class/net/$TUN/statistics/rx_bytes 2>/dev/null || echo 0)
		tx=$(cat /sys/class/net/$TUN/statistics/tx_bytes 2>/dev/null || echo 0)
		now=$(date +%s); pf="$STATE_DIR/stats.prev"; pt=0; prx=0; ptx=0
		[ -f "$pf" ] && read pt prx ptx < "$pf"
		echo "$now $rx $tx" > "$pf"
		dt=$((now-pt)); [ "$dt" -lt 1 ] && dt=1
		rrate=0; trate=0
		if [ "$pt" -gt 0 ] && [ "$rx" -ge "$prx" ]; then rrate=$(((rx-prx)/dt)); trate=$(((tx-ptx)/dt)); fi
		echo "rx_bytes: $rx"; echo "tx_bytes: $tx"
		echo "rx_rate: $rrate"; echo "tx_rate: $trate"
		;;
	sample)
		# called by cron every minute — append-only (builtin read, no forks);
		# ring-buffer trimming happens in pingall, latency trend too (it only
		# changes when ping.cache does)
		[ -r /sys/class/net/$TUN/statistics/rx_bytes ] || exit 0
		read rx < /sys/class/net/$TUN/statistics/rx_bytes
		read tx < /sys/class/net/$TUN/statistics/tx_bytes
		now=$(date +%s); pf="$STATE_DIR/sample.prev"; pt=0; prx=0; ptx=0
		[ -f "$pf" ] && read pt prx ptx < "$pf"
		echo "$now $rx $tx" > "$pf"
		[ "$pt" -gt 0 ] || exit 0
		dt=$((now-pt)); [ "$dt" -lt 1 ] && dt=1
		[ "$rx" -ge "$prx" ] || { prx=$rx; ptx=$tx; }
		echo "$now,$(((rx-prx)/dt)),$(((tx-ptx)/dt))" >> "$TRAFFIC_LOG"
		;;
	history) [ -f "$TRAFFIC_LOG" ] && tail -n 180 "$TRAFFIC_LOG" || true ;;
	update) echo "downloading lists via tunnel…"; /etc/meownetvpn/update-lists.sh download; echo "done. $(/usr/bin/meownetvpn count) subnets in set" ;;
	lists)  echo "available:"; /etc/meownetvpn/update-lists.sh available | tr " " "\n" | sed "/^$/d;s/^/  /" ;;
	list)
		case "$2" in
			show) echo "enabled: $(uci -q get $CONF.settings.community_lists)" ;;
			add)
				[ -n "$3" ] || { echo "usage: meownetvpn list add <name>"; exit 1; }
				cur=" $(uci -q get $CONF.settings.community_lists) "
				case "$cur" in *" $3 "*) echo "$3 already enabled"; exit 0;; esac
				uci set $CONF.settings.community_lists="$(echo $cur $3)"; uci commit $CONF
				echo "enabled $3; run: meownetvpn update" ;;
			del)
				[ -n "$3" ] || { echo "usage: meownetvpn list del <name>"; exit 1; }
				new=$(uci -q get $CONF.settings.community_lists | tr " " "\n" | grep -vx "$3" | tr "\n" " ")
				uci set $CONF.settings.community_lists="$new"; uci commit $CONF
				echo "disabled $3; run: meownetvpn restart" ;;
			*) echo "usage: meownetvpn list [show|add <name>|del <name>]" ;;
		esac ;;
	server)
		case "$2" in
			list|"")
				act=$(active_server)
				for s in $(server_list); do
					mark=" "; [ "$s" = "$act" ] && mark="*"
					echo "$mark $s | $(srv_get "$s" label) | $(srv_get "$s" address):$(srv_get "$s" port) | $(srv_get "$s" transport)"
				done ;;
			add)
				[ $# -ge 7 ] || { echo "usage: meownetvpn server add <label> <ip> <port> <user> <pass> [TCP|UDP]"; exit 1; }
				id="srv$(date +%s)"
				uci set $CONF.$id=server
				uci set $CONF.$id.label="$3"; uci set $CONF.$id.address="$4"; uci set $CONF.$id.port="$5"
				uci set $CONF.$id.username="$6"; uci set $CONF.$id.password="$7"; uci set $CONF.$id.transport="${8:-TCP}"
				uci commit $CONF
				echo "added server $id ($3)" ;;
			del)
				[ -n "$3" ] || { echo "usage: meownetvpn server del <name>"; exit 1; }
				# type guard, the same one `server use` below already had: without
				# it `meownetvpn server del settings` deleted the settings section —
				# enabled, ports, lists, everything — printed "deleted settings"
				# and left the bypass off from the next boot on
				[ "$(uci -q get "$CONF.$3")" = "server" ] || { echo "no such server: $3 (meownetvpn server list)"; exit 1; }
				# a group that keeps the name of a deleted server still gets its
				# tunnel built, with an empty xray server array — its traffic is
				# marked and then black-holed instead of falling back
				for g in $(group_list); do
					uci -q get "$CONF.$g.server" | tr ' ' '\n' | grep -qxF "$3" && {
						uci -q del_list "$CONF.$g.server=$3"; echo "removed from group $g"; }
				done
				[ "$(uci -q get $CONF.settings.active_server)" = "$3" ] && uci -q delete $CONF.settings.active_server
				uci -q delete "$CONF.$3"; uci commit $CONF; echo "deleted $3" ;;
			use)
				[ -n "$3" ] || { echo "usage: meownetvpn server use <name>"; exit 1; }
				[ "$(uci -q get $CONF.$3)" = "server" ] || { echo "no such server: $3"; exit 1; }
				uci set $CONF.settings.active_server="$3"; uci commit $CONF
				echo "active server -> $3; run: meownetvpn restart" ;;
			*) echo "usage: meownetvpn server [list|add|del <name>|use <name>]" ;;
		esac ;;
	group)
		# route a specific list through a specific server via its own tunnel
		case "$2" in
			list|"")
				for g in $(uci show $CONF 2>/dev/null | sed -n "s/^$CONF\.\([^.=]*\)=group$/\1/p"); do
					st=on; [ "$(uci -q get $CONF.$g.enabled)" = "0" ] && st=off
					srvs=""; for s in $(uci -q get $CONF.$g.server); do srvs="$srvs $(srv_get "$s" label)"; done
					echo "  $g [$st] | $(uci -q get $CONF.$g.label) | via:${srvs:- (нет)} | lists: $(uci -q get $CONF.$g.community_lists)"
				done
				[ -z "$(uci show $CONF 2>/dev/null | grep -c '=group')" ] && echo "  (групп нет)" ;;
			add)
				# meownetvpn group add <name> <server-section[ server2]> <list> [list2...]
				[ $# -ge 5 ] || { echo "usage: meownetvpn group add <name> <server-section> <list> [list2...]"; echo "  серверы: meownetvpn server list"; exit 1; }
				# `tr -cd` deletes every byte outside ASCII alnum, and UTF-8
				# Cyrillic/emoji have none — 'Ютуб' and 'Реклама' both collapsed
				# to the bare prefix "g", so the second group add silently ate the
				# first one's label, server and lists. Hash instead of dropping:
				# same name -> same section on a re-run.
				gn="g$(echo "$3" | tr -cd 'a-zA-Z0-9')"
				[ "$gn" = g ] && gn="g$(printf '%s' "$3" | md5sum | cut -c1-8)"
				[ "$(uci -q get "$CONF.$gn")" = "group" ] && {
					echo "группа $gn ($(uci -q get $CONF.$gn.label)) уже существует — выберите другое имя"
					echo "  изменить серверы: meownetvpn group server $gn <server>"
					echo "  удалить: meownetvpn group del $gn"; exit 1; }
				sv="$4"; [ "$(uci -q get $CONF.$sv)" = "server" ] || {
					# try to resolve by label substring
					for s in $(server_list); do case "$(srv_get "$s" label)" in *"$4"*) sv="$s"; break;; esac; done; }
				[ "$(uci -q get $CONF.$sv)" = "server" ] || { echo "no such server: $4 (meownetvpn server list)"; exit 1; }
				uci set $CONF.$gn=group; uci set $CONF.$gn.enabled=1
				uci set $CONF.$gn.label="$3"; uci -q delete $CONF.$gn.server; uci add_list $CONF.$gn.server="$sv"
				shift 4; uci set $CONF.$gn.community_lists="$*"
				uci commit $CONF
				echo "group $gn: lists [$*] via $(srv_get "$sv" label); run: meownetvpn restart && meownetvpn update" ;;
			del)
				[ -n "$3" ] || { echo "usage: meownetvpn group del <name>"; exit 1; }
				# same type guard as `server del`: this deleted any section it was
				# handed, settings included
				[ "$(uci -q get "$CONF.$3")" = "group" ] || { echo "no such group: $3 (meownetvpn group list)"; exit 1; }
				uci -q delete "$CONF.$3"; uci commit $CONF; echo "deleted $3; run: meownetvpn restart" ;;
			server)
				# meownetvpn group server <name> <server-section[ server2 ...]>  (set the group's servers)
				[ -n "$3" ] && [ -n "$4" ] || { echo "usage: meownetvpn group server <name> <server-section...>"; exit 1; }
				gn="$3"; shift 3; uci -q delete $CONF.$gn.server; for s in $*; do uci add_list $CONF.$gn.server="$s"; done; uci commit $CONF
				echo "group $gn -> servers: $*; run: meownetvpn restart" ;;
			*) echo "usage: meownetvpn group [list|add <name> <server> <lists...>|del <name>|server <name> <servers...>]" ;;
		esac ;;
	sub)
		# import xray servers from a Clash-format subscription (meownetvpn etc.)
		url="$2"; [ -n "$url" ] || { echo "usage: meownetvpn sub <clash-subscription-url>"; exit 1; }
		tmp="$STATE_DIR/sub.yaml"; tsv="$STATE_DIR/sub.tsv"
		echo "fetching subscription…"
		curl -fsSL --max-time 30 "$url" -o "$tmp" 2>/dev/null || { echo "download failed"; exit 1; }
		# A subscription arrives in one of two shapes and both are in the wild: Clash
		# YAML (what the xray panel serves) and a list of proxy URIs, usually
		# base64-wrapped (what VLESS panels serve). Detect it — the operator pastes a
		# link, not a format, and guessing wrong reports "no servers found" for a
		# subscription that is perfectly fine.
		if grep -qE '^[[:space:]]*(proxies|mixed-port|port):' "$tmp" 2>/dev/null; then
			fmt=clash
		elif grep -q '://' "$tmp" 2>/dev/null; then
			fmt=uri
		else
			tr -d '\n\r' < "$tmp" | base64 -d > "$tmp.dec" 2>/dev/null
			if grep -q '://' "$tmp.dec" 2>/dev/null; then mv "$tmp.dec" "$tmp"; fmt=uri
			else rm -f "$tmp.dec" "$tmp"; echo "unrecognised subscription format (not Clash YAML, not a proxy-URI list)"; exit 1; fi
		fi

		# TSV columns, one row per server:
		#   type name server port net user pass mux sni path host sec flow fp xmode
		# `net` carries the xray transport (TCP/UDP) or the vless stream network.
		# `user` carries the xray username or the vless uuid — one column, because
		# every consumer below already branches on `type` anyway.
		if [ "$fmt" = clash ]; then
		awk '
		  # A YAML scalar: strip only a MATCHED surrounding quote pair. The old
		  # blanket gsub(/"/,"",v) deleted quotes INSIDE the value too, and a
		  # generated password may well contain one. Only an unquoted scalar can
		  # carry a trailing "# comment".
		  function val(l,   v) {
		    v = l
		    sub(/^[^:]*:[[:space:]]*/, "", v)
		    sub(/[[:space:]]+$/, "", v)
		    if (v ~ /^".*"$/) return substr(v, 2, length(v) - 2)
		    if (v ~ /^'"'"'.*'"'"'$/) return substr(v, 2, length(v) - 2)
		    sub(/[[:space:]]+#.*$/, "", v)
		    return v
		  }
		  # TAB is an IFS *whitespace* character, so `read` collapses a run of them and
		  # an empty column in the middle silently shifts every later value one place
		  # left — the security ends up in the path, the path in the host. Never emit an
		  # empty field: "-" stands for one, and no value here can legitimately be "-"
		  # (a path starts with "/", a uuid is hex, a level is an enum).
		  function d(v) { return (v == "") ? "-" : v }
		  function emit() {
		    if (s == "" || t != "vless") return
		    if (sni == "") sni = s
		    if (net == "") net = "tcp"
		    print "vless\t"d(n)"\t"s"\t"p"\t"net"\t"d(uuid)"\t"d(alpn)"\t"d(xtra)"\t"d(sni)"\t"d(path)"\t"d(hh)"\t"d(sec)"\t"d(flow)"\t"d(fp)"\t"d(xmode)
		  }
		  # A new proxy begins at the first "- <key>:" of a YAML sequence item — NOT at
		  # "- name:". Nothing orders the keys, and this panel emits them alphabetically,
		  # so the block starts with "- alpn:" and a name-anchored rule never fires: every
		  # proxy folds into one record with an empty label and alpn concatenated five
		  # times over. The line is then rewritten as a plain key so the handlers below
		  # still see it. An alpn list item ("- h2") carries no colon and is left alone.
		  /^[[:space:]]*-[[:space:]]*[A-Za-z0-9_-]+:/ {
		    emit()
		    n="";t="";s="";p=""
		    uuid="";sni="";path="";hh="";sec="";flow="";fp="";xmode="";net="";alpn="";xtra=""
		    sub(/^[[:space:]]*-[[:space:]]*/, "  ")
		  }
		  /^[[:space:]]*name:/          {n=val($0)}
		  /^[[:space:]]*type:/         {t=val($0)}
		  /^[[:space:]]*server:/       {s=val($0)}
		  /^[[:space:]]*port:/         {p=val($0)}
		  /^[[:space:]]*uuid:/         {uuid=val($0)}
		  /^[[:space:]]*(servername|sni):/ {sni=val($0)}
		  /^[[:space:]]*network:/      {net=val($0)}
		  /^[[:space:]]*(client-fingerprint|fingerprint):/ {fp=val($0)}
		  /^[[:space:]]*alpn:/         {alpn=val($0); gsub(/[][ ]/, "", alpn)}
		  # Clash lists alpn as a YAML sequence, one value per line under the key.
		  /^[[:space:]]*-[[:space:]]*(h2|h3|http\/1\.1)[[:space:]]*$/ {
		    v=$0; sub(/^[[:space:]]*-[[:space:]]*/,"",v); sub(/[[:space:]]+$/,"",v)
		    alpn = (alpn == "") ? v : alpn "," v }
		  # xhttp-opts carries the padding under its own key; the URI form calls the
		  # same thing `extra`, so normalise to that rather than inventing a field.
		  /^[[:space:]]*x-padding-bytes:/ {xtra="{\"xPaddingBytes\":\"" val($0) "\"}"}
		  /^[[:space:]]*flow:/         {flow=val($0)}
		  /^[[:space:]]*tls:/          {if (val($0) == "true") sec="tls"}
		  /^[[:space:]]*path:/         {if (path == "") path=val($0)}
		  /^[[:space:]]*host:/         {if (hh == "") hh=val($0)}
		  /^[[:space:]]*mode:/         {xmode=val($0)}
		  /^[[:space:]]*grpc-service-name:/ {path="/" val($0)}
		  END { emit() }
		' "$tmp" > "$tsv"
		else
		# ── proxy-URI list ────────────────────────────────────────────────────────
		# vless://<uuid>@<host>:<port>?<query>#<label>
		# Only vless is imported; a vmess/ss/trojan line is skipped with a word, not
		# silently, so "10 servers in the panel, 4 imported" is explainable.
		: > "$tsv"
		urldec() { printf '%b' "$(printf '%s' "$1" | sed 's/+/ /g; s/%/\\x/g')"; }
		qval() {  # $1=query $2=key -> value ("" if absent)
			printf '%s' "$1" | tr '&' '\n' | awk -F= -v k="$2" '$1==k{sub(/^[^=]*=/,""); print; exit}'
		}
		while IFS= read -r line; do
			line=$(printf '%s' "$line" | tr -d '\r')
			case "$line" in
				vless://*) ;;
				vmess://*|ss://*|trojan://*|hysteria*://*)
					echo "  skipped $(printf '%s' "$line" | cut -d: -f1): only vless is supported"; continue ;;
				*) continue ;;
			esac
			body=${line#vless://}
			label=""; case "$body" in *"#"*) label=$(urldec "${body##*#}"); body=${body%%#*} ;; esac
			query="";  case "$body" in *"?"*) query=${body#*\?}; body=${body%%\?*} ;; esac
			uuid=${body%%@*}; hostport=${body#*@}
			# IPv6 literals arrive as [::1]:443 — splitting on the LAST colon keeps them intact
			case "$hostport" in
				\[*\]:*) host=${hostport%%\]:*}; host=${host#\[}; port=${hostport##*]:} ;;
				*) host=${hostport%:*}; port=${hostport##*:} ;;
			esac
			[ -n "$uuid" ] && [ -n "$host" ] && [ -n "$port" ] || { echo "  skipped a malformed vless:// line"; continue; }
			net=$(qval "$query" type);      [ -n "$net" ] || net=tcp
			sec=$(qval "$query" security);  [ -n "$sec" ] || sec=none
			sni=$(urldec "$(qval "$query" sni)"); [ -n "$sni" ] || sni=$(urldec "$(qval "$query" peer)")
			[ -n "$sni" ] || sni="$host"
			path=$(urldec "$(qval "$query" path)")
			hh=$(urldec "$(qval "$query" host)"); [ -n "$hh" ] || hh="$sni"
			flow=$(qval "$query" flow)
			fp=$(qval "$query" fp);         [ -n "$fp" ] || fp=chrome
			xmode=$(qval "$query" mode);    [ -n "$xmode" ] || xmode=auto
			alpn=$(urldec "$(qval "$query" alpn)")
			# `extra` carries a JSON blob of transport options the URI form has no
			# named slot for (xPaddingBytes and friends). Pass it through verbatim
			# rather than trying to model each key: Xray owns that schema, it grows,
			# and a field we silently drop is a traffic shape that no longer matches
			# what the panel handed out — which is the one thing DPI is looking at.
			xextra=$(urldec "$(qval "$query" extra)")
			[ -n "$label" ] || label="$host:$port"
			# "-" for an absent value, never an empty column — see the note in the awk
			# above: a run of TABs collapses in `read` and shifts every later field.
			for v in label net uuid sni path hh sec flow fp xmode alpn xextra; do
				eval "[ -n \"\$$v\" ] || $v=-"
			done
			printf 'vless\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
				"$label" "$host" "$port" "$net" "$uuid" "$alpn" "$xextra" "$sni" "$path" "$hh" "$sec" "$flow" "$fp" "$xmode" >> "$tsv"
		done < "$tmp"
		fi
		cnt=$(grep -c . "$tsv" 2>/dev/null)
		[ "${cnt:-0}" -gt 0 ] || { echo "no vless servers found in subscription"; rm -f "$tmp" "$tsv"; exit 1; }
		# Import in place. Wiping every server section first orphaned the section
		# NAMES that group.server and settings.active_server store: init.d then
		# built those tunnels with an empty xray server array, so the group's
		# traffic was marked and black-holed. A section that still carries the
		# same endpoint therefore keeps its name.
		# What makes two entries the SAME server. Address and port are not enough:
		# a panel can front several exits behind one TLS endpoint and tell them apart
		# by the XHTTP path — five "countries" arriving as one host:port with paths
		# /api/video/hls, /api/audio/track and so on. Keyed on host:port alone, four
		# of those five collapse into one section and the country choice is silently
		# lost; the import even says "skipped duplicate" while doing it.
		find_srv() {  # $1=address $2=port $3=path -> existing server section, if any
			local s
			for s in $(server_list); do
				[ "$(srv_get "$s" address)" = "$1" ] || continue
				[ "$(srv_get "$s" port)" = "$2" ] || continue
				[ "$(srv_get "$s" path)" = "$3" ] || continue
				echo "$s"; return
			done
		}
		TAB=$(printf '	'); first=""; keep=""; imported=0
		# read -r: without it a backslash in a generated password is eaten before
		# it ever reaches uci, and xray then fails to authenticate everywhere —
		# indistinguishable from the DPI blocking this module fights
		nvless=0
		# "-" is the empty marker the two parsers above agree on
		unmark() { [ "$1" = "-" ] && echo "" || echo "$1"; }
		# Columns 7 and 8 carry alpn and the transport `extra` blob.
		while IFS="$TAB" read -r styp name srv port net user pass mux sni path hh sec flow fp xmode; do
			[ -n "$srv" ] || continue
			name=$(unmark "$name"); net=$(unmark "$net"); user=$(unmark "$user")
			pass=$(unmark "$pass"); mux=$(unmark "$mux"); sni=$(unmark "$sni")
			path=$(unmark "$path"); hh=$(unmark "$hh");   sec=$(unmark "$sec")
			flow=$(unmark "$flow"); fp=$(unmark "$fp");   xmode=$(unmark "$xmode")
			# a non-numeric port lands verbatim in the generated JSON and makes the
			# whole profile invalid, taking every tunnel down with it
			case "$port" in ''|*[!0-9]*) echo "  skipped $srv: bad port '$port'"; continue ;; esac
			id=$(find_srv "$srv" "$port" "$path")
			if [ -n "$id" ]; then
				case " $keep " in
					*" $id "*) echo "  skipped duplicate $srv:$port$path"; continue ;;
				esac
			else
				# NOT the digits of the address: 203.0.113.9 and 20.30.113.9
				# squeeze to the same id, and hostnames to none at all, so the
				# second server silently overwrote the first. The path is part of the
				# key for the same reason find_srv uses it — see above.
				id="srv$(printf '%s' "$srv:$port:$path" | md5sum | cut -c1-10)"
			fi
			# Carry over the two fields an OPERATOR sets by hand, then wipe the section
			# and write it fresh. Setting over the old one leaves stale keys behind, and
			# a section that changes protocol keeps a password or a uuid that no longer
			# applies — the generated config then carries a credential from the other
			# engine, which fails in a way that looks like the server rejecting us.
			ofail=$(uci -q get $CONF.$id.failover)
			oprobe=$(uci -q get $CONF.$id.probe_url)
			uci -q delete $CONF.$id
			uci set $CONF.$id=server
			uci set $CONF.$id.label="$name"
			uci set $CONF.$id.address="$srv"
			uci set $CONF.$id.port="$port"
			[ -n "$ofail" ] && uci set $CONF.$id.failover="$ofail"
			[ -n "$oprobe" ] && uci set $CONF.$id.probe_url="$oprobe"
			if [ "$styp" = vless ]; then
				uci set $CONF.$id.type='vless'
				uci set $CONF.$id.uuid="$user"
				uci set $CONF.$id.network="${net:-tcp}"
				uci set $CONF.$id.security="${sec:-none}"
				[ -n "$sni" ]   && uci set $CONF.$id.sni="$sni"
				[ -n "$path" ]  && uci set $CONF.$id.path="$path"
				[ -n "$hh" ]    && uci set $CONF.$id.host="$hh"
				[ -n "$flow" ]  && uci set $CONF.$id.flow="$flow"
				[ -n "$pass" ]  && uci set $CONF.$id.alpn="$pass"
				[ -n "$mux" ]   && uci set $CONF.$id.extra="$mux"
				[ -n "$fp" ]    && uci set $CONF.$id.fingerprint="$fp"
				[ -n "$xmode" ] && uci set $CONF.$id.xmode="$xmode"
				nvless=$((nvless+1))
			fi
			keep="$keep $id"; imported=$((imported+1))
			[ -z "$first" ] && first="$id"
		done < "$tsv"
		[ "$imported" -gt 0 ] || { echo "subscription parsed, but no usable server in it"; rm -f "$tmp" "$tsv"; exit 1; }
		# only now drop what the subscription no longer offers
		for s in $(server_list); do
			case " $keep " in *" $s "*) continue ;; esac
			uci -q delete "$CONF.$s"; echo "  removed $s (gone from subscription)"
		done
		# repair the references the removal above just broke — an empty group
		# server list is not "no tunnel", it is a tunnel that swallows traffic
		for g in $(group_list); do
			gs=$(grp_get "$g" server); new=""; dropped=0
			for s in $gs; do
				case " $keep " in
					*" $s "*) new="$new $s" ;;
					*) dropped=1 ;;
				esac
			done
			[ "$dropped" = 1 ] || continue
			uci -q delete "$CONF.$g.server"
			for s in $new; do uci add_list "$CONF.$g.server=$s"; done
			if [ -z "$new" ]; then
				uci add_list "$CONF.$g.server=$first"
				echo "  group $g lost every server -> $(srv_get "$first" label)"
			else
				echo "  group $g: dropped server(s) gone from subscription"
			fi
		done
		# do not undo what best-server/watchdog chose: only move the active
		# server when the section it names no longer exists
		aprev=$(uci -q get $CONF.settings.active_server); akeep=0
		[ -n "$aprev" ] && case " $keep " in *" $aprev "*) akeep=1 ;; esac
		[ "$akeep" = 1 ] || uci set $CONF.settings.active_server="$first"
		uci set $CONF.settings.sub_url="$url"   # remember subscription for auto-refresh
		uci commit $CONF
		rm -f "$tmp" "$tsv"
		# $cnt counts TSV rows; report what actually reached uci
		echo "imported $imported vless server(s); active=$(uci -q get $CONF.settings.active_server)"
		[ "$nvless" -gt 0 ] && [ ! -x /usr/bin/xray ] && \
			echo "WARNING: vless servers imported but /usr/bin/xray is missing — run: meownetvpn install-xray"
		echo "run: meownetvpn restart"
		;;
	install-xray)
		# Xray ships a 32 MB binary and these routers have ~20 MB of overlay, so the
		# upstream release simply does not fit — the mirror carries a UPX-packed build
		# (~7.6 MB, measured) which does, and which starts in the same second. Falling
		# back to the upstream zip would "succeed" at filling the flash and brick the
		# overlay, so there is deliberately no such fallback: a missing mirror is an
		# error you can act on, a full flash is not.
		base=$(uci -q get $CONF.settings.xray_mirror)
		[ -n "$base" ] || base="https://meownetvpn.app/updates/xray"
		arch=$(uname -m)
		case "$arch" in
			aarch64|arm64) a=arm64 ;;
			armv7l|armv7)  a=arm32 ;;
			x86_64|amd64)  a=amd64 ;;
			mips)          a=mips ;;
			mipsel|mipsle) a=mipsle ;;
			*) echo "unsupported architecture: $arch"; exit 1 ;;
		esac
		url="$base/xray-$a"
		echo "fetching $url"
		tmpb=/tmp/xray.dl; rm -f "$tmpb"
		curl -fs --proxy "$PROXY" --max-time 300 -o "$tmpb" "$url" 2>/dev/null || \
		curl -fs --max-time 300 -o "$tmpb" "$url" 2>/dev/null || { echo "download failed"; rm -f "$tmpb"; exit 1; }
		[ -s "$tmpb" ] || { echo "downloaded file is empty"; rm -f "$tmpb"; exit 1; }
		chmod +x "$tmpb"
		# Verify it RUNS before it is allowed near /usr/bin: a UPX-packed binary can
		# unpack fine on one kernel and fault on another, and an xray that faults is a
		# tunnel that never comes up on a router you may not be standing next to.
		v=$("$tmpb" version 2>&1 | head -1)
		case "$v" in
			Xray*) : ;;
			*) echo "downloaded binary does not run here: $v"; rm -f "$tmpb"; exit 1 ;;
		esac
		free=$(df -k /overlay 2>/dev/null | awk 'NR==2{print $4}')
		need=$(( $(wc -c < "$tmpb") / 1024 + 512 ))
		if [ -n "$free" ] && [ "$free" -lt "$need" ]; then
			echo "not enough overlay space: ${free}K free, ${need}K needed"
			echo "free some up: 'meownetvpn drop-mieru' reclaims the ~12MB mieru occupies"
			rm -f "$tmpb"; exit 1
		fi
		mv "$tmpb" /usr/bin/xray && chmod +x /usr/bin/xray
		echo "installed: $(/usr/bin/xray version 2>&1 | head -1)"
		echo "overlay now: $(df -h /overlay 2>/dev/null | awk 'NR==2{print $4" free"}')"
		;;
	drop-mieru)
		# mieru is no longer a transport this module can run, so its binary is just
		# ~12 MB of overlay nothing opens. Left behind on every router migrated from
		# mierukop, and overlay on these boxes is ~30 MB in total — which is why
		# install-xray points at this command when it runs out of room.
		if [ ! -e /usr/bin/mieru ]; then echo "mieru is not installed"; exit 0; fi
		[ -x /etc/init.d/mieru ] && /etc/init.d/mieru stop >/dev/null 2>&1
		rm -f /usr/bin/mieru
		rm -rf /root/.config/mieru /var/run/meownetvpn/mieru*.json 2>/dev/null
		echo "mieru removed; overlay: $(df -h /overlay 2>/dev/null | awk 'NR==2{print $4" free"}')"
		;;
	set-server)
		[ $# -eq 4 ] || { echo "usage: meownetvpn set-server <host> <port> <uuid>"; exit 1; }
		sv=$(active_server)
		[ -n "$sv" ] || { sv=main; uci set $CONF.$sv=server; uci set $CONF.settings.active_server=$sv; uci set $CONF.$sv.label="Server 1"; }
		uci set $CONF.$sv.type='vless'
		uci set $CONF.$sv.address="$2"; uci set $CONF.$sv.port="$3"
		uci set $CONF.$sv.uuid="$4"
		uci commit $CONF
		echo "saved to server '$sv'; run: meownetvpn restart"
		;;
	count)
		# Count ELEMENTS, with the very expression update-lists.sh uses to write
		# this same file: the sets are `flags interval; auto-merge`, so nft prints
		# merged neighbours as ranges and DNS-learned hosts bare, and the old
		# '/prefix' regex matched neither (49 against 128 on this router). Two
		# writers with two answers meant the dashboard showed whichever ran last.
		c=$(nft list set $NFT_TABLE $NFT_SET 2>/dev/null | \
			grep -oE '([0-9]+\.){3}[0-9]+(/[0-9]+)?(-([0-9]+\.){3}[0-9]+)?' | wc -l)
		echo "$c" > "$STATE_DIR/subnets.count"; echo "$c" ;;
	add-domain)
		[ -n "$2" ] || { echo "usage: meownetvpn add-domain <domain>"; exit 1; }
		uci add_list $CONF.user.domain="$2"; uci commit $CONF
		echo "added domain $2; run: meownetvpn restart"
		;;
	add-subnet)
		[ -n "$2" ] || { echo "usage: meownetvpn add-subnet <cidr>"; exit 1; }
		uci add_list $CONF.user.subnet="$2"; uci commit $CONF
		nft add element $NFT_TABLE $NFT_SET "{ $2 }" 2>/dev/null
		echo "added subnet $2"
		;;
	*) usage ;;
esac
